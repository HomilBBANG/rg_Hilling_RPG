; Engine configuration file.
; Denial — P0 visual tech prototype (Godot 4.7)

config_version=5

[application]

config/name="Denial"
config/description="P0 그래픽 기술 검증 프로토타입: 고정 탑다운 3D + 픽셀화 렌더"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=0
